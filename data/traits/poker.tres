[gd_resource type="Resource" script_class="PokerTrait" format=3]

[ext_resource type="Script" path="res://core/data/traits/poker_trait.gd" id="1_raeoc"]

[resource]
script = ExtResource("1_raeoc")
id = &"poker"
display_name = "포커카드"
description = "2면 주사위 전용. 면이 A(1) ~ K(13)로 바뀐다.
A가 나오면 거인, K가 나오면 킹을 배치할 수 있다.
변환 시 수트(♠♥♦♣) 1개가 정해진다."
badge = "포커"
